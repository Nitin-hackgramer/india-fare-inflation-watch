# Copy to .env.local. Placeholders only — never commit real values.
# Leave VITE_API_BASE_URL empty to run on built-in DEMO DATA (no backend needed).

# FastAPI base URL, e.g. https://airfare-index-api.onrender.com (no trailing slash)
VITE_API_BASE_URL=
# Set to "false" (with VITE_API_BASE_URL set) to use the live API instead of demo data
VITE_USE_MOCK_DATA=true

# Optional, not used by the demo. Publishable (anon) key only — never the service_role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend only (FastAPI on Render). No VITE_ prefix, so Vite never ships it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
